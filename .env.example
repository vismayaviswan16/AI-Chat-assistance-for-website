# ====================================================================
# Copy this file to a new file named .env and fill in your values.
# NEVER commit .env to GitHub. It is already listed in .gitignore.
# ====================================================================

# --- Lead emails (optional) -----------------------------------------
# If you leave SENDER_EMAIL or SENDER_APP_PASSWORD empty, leads are only
# printed in the terminal and no email is sent.

# FILL IN: the email account that sends the lead notification
SENDER_EMAIL=

# FILL IN: an app password for that account, NOT your normal password.
# For Gmail: turn on 2-step verification, then create an app password in
# your Google account's security settings.
SENDER_APP_PASSWORD=

# FILL IN: where lead emails are delivered.
# If left empty, they go to SENDER_EMAIL.
LEAD_RECIPIENT=

# --- Optional settings ----------------------------------------------
# Remove the # at the start of a line to use it.

# Email server, if you don't use Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# AI models. EMBED_MODEL must be the same when you run embed.py and server.py:
# CHAT_MODEL=qwen3:4b
# EMBED_MODEL=nomic-embed-text

# Server address:
# HOST=127.0.0.1
# PORT=3000