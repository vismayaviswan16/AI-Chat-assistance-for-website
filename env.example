# Copy this file to ".env" and fill in your values. Never commit ".env".

# =====================================================================
# 1. CHOOSE YOUR AI  (pick ONE chat option, then ONE retrieval option)
# =====================================================================
#
# ---- CHAT: the model that writes the answers -------------------------
# CHAT_PROVIDER: ollama | openai | anthropic | gemini | groq | openrouter | lmstudio | custom
#
# Option A - Ollama (free, runs on your own computer/server)   <- default
CHAT_PROVIDER=ollama
CHAT_MODEL=qwen3:4b
# OLLAMA_HOST=http://127.0.0.1:11434
#
# Option B - OpenAI
# CHAT_PROVIDER=openai
# CHAT_MODEL=<a model name from your OpenAI account>
# OPENAI_API_KEY=sk-...
#
# Option C - Anthropic (Claude)
# CHAT_PROVIDER=anthropic
# CHAT_MODEL=claude-haiku-5-5        # see Anthropic's docs for the current model list
# ANTHROPIC_API_KEY=sk-ant-...
#
# Option D - Google Gemini
# CHAT_PROVIDER=gemini
# CHAT_MODEL=<a Gemini model name>
# GEMINI_API_KEY=...
#
# Option E - Groq or OpenRouter
# CHAT_PROVIDER=groq                  # or: openrouter
# CHAT_MODEL=<model name from that service>
# GROQ_API_KEY=...                    # or: OPENROUTER_API_KEY=...
#
# Option F - LM Studio (local, no key needed; start its local server first)
# CHAT_PROVIDER=lmstudio
# CHAT_MODEL=<the model name shown in LM Studio>
#
# Option G - Anything else that speaks the OpenAI API (vLLM, Together, Mistral, DeepSeek, ...)
# CHAT_PROVIDER=custom
# CHAT_MODEL=<model name>
# CHAT_BASE_URL=https://api.example.com/v1
# CHAT_API_KEY=...
#
# Tip: CHAT_API_KEY / CHAT_BASE_URL work with every provider and override the defaults above.
# CHAT_MAX_TOKENS=500                 # optional cap on answer length (also caps your cost)
# CHAT_TIMEOUT_SECONDS=90

# ---- RETRIEVAL: how the assistant finds the right part of your content ----
# EMBED_PROVIDER: keyword | ollama | openai | gemini | openrouter | lmstudio | custom
#   keyword = no AI model needed, works with any chat provider. Matches words, not meaning.
#   Others  = understand meaning ("cost" finds "pricing"). Needs an embedding model.
# If you leave this out: Ollama chat users get Ollama embeddings, everyone else gets keyword.
#
# Ollama embeddings (default for Ollama users; run: ollama pull nomic-embed-text)
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
#
# OpenAI embeddings
# EMBED_PROVIDER=openai
# EMBED_MODEL=text-embedding-3-small
#
# Keyword search (simplest; good for small, clearly written knowledge files)
# EMBED_PROVIDER=keyword
#
# Other providers: set EMBED_PROVIDER, EMBED_MODEL, and EMBED_API_KEY / EMBED_BASE_URL.
#
# IMPORTANT: after changing any EMBED_* setting or editing knowledge/*.txt, run: python embed.py

# =====================================================================
# 2. SERVER
# =====================================================================
HOST=127.0.0.1
PORT=3000
# Set to 1 when running behind nginx / a load balancer so rate limits see real visitor IPs
# BEHIND_PROXY=1

# =====================================================================
# 3. SECURITY (IMPORTANT before you deploy)
# =====================================================================
# Only these websites may call the API. Comma-separated. "*" means any site (local testing only).
ALLOWED_ORIGINS=*
# Example: ALLOWED_ORIGINS=https://yourwebsite.com,https://www.yourwebsite.com
CHAT_RATE_LIMIT=20 per minute;300 per day
LEAD_RATE_LIMIT=5 per hour
MAX_MESSAGE_CHARS=500
# Using a paid provider? Cap total chats per day across ALL visitors (0 = no cap).
DAILY_CHAT_LIMIT=0

# =====================================================================
# 4. ANSWER QUALITY (all optional)
# =====================================================================
# Embedding search: matches scoring below MIN_SCORE are ignored so the bot says "I'm not sure"
# instead of guessing. Raise it (0.45) if answers drift off-topic; lower it (0.25) if it says
# "not sure" too often. Keyword search uses MIN_KEYWORD_COVERAGE (0 to 1) the same way.
MIN_SCORE=0.35
MIN_KEYWORD_COVERAGE=0.4
TOP_K=3
MAX_HISTORY=10
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# =====================================================================
# 5. PERFORMANCE (all optional)
# =====================================================================
MAX_CONCURRENT_CHATS=2
SESSION_TTL_SECONDS=1800

# =====================================================================
# 6. LEAD NOTIFICATION EMAILS (optional)
# =====================================================================
# Without these, leads are only saved to leads.jsonl.
SENDER_EMAIL=
SENDER_APP_PASSWORD=
LEAD_RECIPIENT=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
